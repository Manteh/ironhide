{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IronHide",
  "version": "0.1.0",
  "identifier": "app.ironhide.mac",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Entertainment",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../../src": "ironhide/src",
      "../../web": "ironhide/web",
      "../../node_modules": "ironhide/node_modules",
      "../../package.json": "ironhide/package.json"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}